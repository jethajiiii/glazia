# ──────────────────────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in real values.  Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# HTTP port the Express server listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/mini-design-canvas
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mini-design-canvas

# Allowed CORS origin for the React client
# Development: http://localhost:5173
# Production:  https://<your-vercel-app>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development

# Rate-limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per window
RATE_LIMIT_MAX=100

# Maximum accepted request body size (express body-parser)
BODY_LIMIT=10mb
